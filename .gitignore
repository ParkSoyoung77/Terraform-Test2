# === 1. 보안 및 환경 변수 (최우선 제외) ===
# API 키, DB 비밀번호 등 민감 정보
.env
.env.*
!.env.example
# AWS 접속용 키 페어 / 암호화 키
*.pem
*.key
# AWS 자격증명 실수 방지
.aws/

# === 2. Python 가상 환경 및 패키지 ===
venv/
.venv/
env/
bin/
lib/
include/

# === 3. Python 캐시 및 컴파일 파일 ===
__pycache__/
*.py[cod]
*$py.class

# === 4. 운영체제 및 도구 설정 ===
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# === 5. 빌드 및 배포 결과물 ===
build/
dist/
*.egg-info/

# === 6. Terraform 상태 및 캐시 파일 ===
.terraform/
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform.tfstate.lock.info
crash.log
crash.*.log

# Terraform 변수 파일 (민감 정보 포함 가능)
*.tfvars
*.tfvars.json
!*.tfvars.example
*.auto.tfvars
*.auto.tfvars.json

# Terraform lock 파일 및 CLI 설정
.terraform.lock.hcl
.terraformrc
terraform.rc

# Terraform override / plan 파일
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*tfplan*
*.tfplan
*.backup

# === 7. 각 모듈 내부 state/캐시 대비 ===
**/modules/**/.terraform/*
**/modules/**/*.tfstate
**/modules/**/*.tfstate.*