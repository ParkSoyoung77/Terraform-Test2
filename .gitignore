# === 1. 보안 및 환경 변수 (최우선 제외) ===
.env                # API 키, DB 비밀번호 등 민감 정보
.env.*
!.env.example
*.pem               # AWS 접속용 키 페어
*.key               # 암호화 키 파일
.aws/               # AWS 자격증명 실수 방지

# === 2. Python 가상 환경 및 패키지 ===
venv/               # 가상 환경 폴더 (주로 사용하는 이름)
.venv/              # 표준 가상 환경 폴더
env/
bin/
lib/
include/

# === 3. Python 캐시 및 컴파일 파일 ===
__pycache__/        # 런타임 시 생성되는 바이트코드 캐시
*.py[cod]           # .pyc, .pyo, .pyd 파일
*$py.class

# === 4. 운영체제 및 도구 설정 ===
.DS_Store           # macOS 전용 시스템 파일
Thumbs.db           # Windows 전용 썸네일 파일
.vscode/            # VS Code 개인 설정 (팀별로 다를 수 있음)
.idea/              # PyCharm 설정 파일
*.swp

# === 5. 빌드 및 배포 결과물 ===
build/
dist/
*.egg-info/

# === 6. Terraform 상태 및 캐시 파일 ===
.terraform/
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform.tfstate.lock.info
crash.log
crash.*.log

# Terraform 변수 파일 (민감 정보 포함 가능)
*.tfvars
*.tfvars.json
!*.tfvars.example
*.auto.tfvars        # 로컬 개발/테스트용 (환경별로 나눴을 때 공유 X)
*.auto.tfvars.json

# Terraform lock 파일 및 CLI 설정
.terraform.lock.hcl
.terraformrc
terraform.rc

# Terraform override / plan 파일
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*tfplan*
*.tfplan
*.backup
# !example_override.tf   # 버전 관리에 포함하고 싶은 override 파일은 이렇게 예외 처리

# === 7. 각 모듈 내부 state/캐시 대비 ===
**/modules/**/.terraform/*
**/modules/**/*.tfstate
**/modules/**/*.tfstate.*