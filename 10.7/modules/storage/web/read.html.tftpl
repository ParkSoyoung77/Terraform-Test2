<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>S3 파일 관리</title>
  <style>
    :root { --bg:#f6f7f9; --card:#fff; --text:#1f2937; --muted:#6b7280; --line:#e5e7eb; --accent:#ff9900; --navy:#232f3e; --link:#0b6bcb; --err:#c0392b; --ok:#15803d; --danger:#d33; }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: -apple-system, "Segoe UI", "Malgun Gothic", sans-serif; background: var(--bg); color: var(--text); }
    header { background: var(--navy); color: #fff; padding: 14px 16px; }
    header .inner, main { max-width: 860px; margin: 0 auto; }
    header .inner { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
    header h1 { margin: 0; font-size: 18px; }
    nav a { color: #cbd5e1; text-decoration: none; margin-left: 14px; font-size: 14px; }
    nav a.active { color: var(--accent); font-weight: 700; }
    main { padding: 20px 16px; }
    .card { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 16px; margin-bottom: 16px; }
    .card h2 { margin: 0 0 12px; font-size: 16px; }
    label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 4px; }
    input { width: 100%; padding: 9px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 14px; margin-bottom: 12px; }
    input:focus { outline: 2px solid var(--accent); border-color: var(--accent); }
    .mono { font-family: Consolas, "D2Coding", monospace; }
    .row { display: flex; gap: 12px; }
    .row > div { flex: 1; }
    .actions { display: flex; gap: 8px; flex-wrap: wrap; }
    button { padding: 10px 18px; border: 0; border-radius: 6px; background: var(--accent); color: var(--navy); font-weight: 700; font-size: 14px; cursor: pointer; }
    button.danger { background: var(--danger); color: #fff; }
    button.blue { background: #0b6bcb; color: #fff; }
    button.secondary { background: #e2e8f0; color: var(--text); }
    button:disabled { background: #cbd5e1; color: #fff; cursor: default; }
    .hint { color: var(--muted); font-size: 12px; margin: -6px 0 12px; }
    .result-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 10px; }
    .result-head h2 { margin: 0; }
    .msg { font-size: 14px; font-weight: 600; margin-bottom: 10px; white-space: pre-wrap; word-break: break-all; }
    .msg.ok { color: var(--ok); }
    .msg.error { color: var(--err); }
    .meta { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }
    .chip { background: #f1f5f9; border: 1px solid var(--line); border-radius: 999px; padding: 3px 10px; font-size: 12px; font-family: Consolas, monospace; word-break: break-all; }
    pre { margin: 0; background: #0f172a; color: #e2e8f0; padding: 14px; border-radius: 6px; font-family: Consolas, "D2Coding", monospace; font-size: 13px; line-height: 1.5; white-space: pre-wrap; word-break: break-all; max-height: 60vh; overflow: auto; }
    pre.placeholder { background: #f1f5f9; color: var(--muted); }
    @media (max-width: 600px) { .row { flex-direction: column; gap: 0; } }
  </style>
</head>
<body>
  <header>
    <div class="inner">
      <h1>S3 파일 관리</h1>
      <nav>
        <a href="#" id="navList">파일 목록</a>
        <a href="#" id="navRead" class="active">파일 관리</a>
      </nav>
    </div>
  </header>

  <main>
    <!-- 대상 파일 -->
    <section class="card">
      <label for="api">Lambda 함수 URL</label>
      <input id="api" class="mono" placeholder="https://xxxxxxxx.lambda-url.eu-west-2.on.aws/">

      <label for="bucket">버킷 이름</label>
      <input id="bucket" class="mono" placeholder="예: std17-test-bucket">

      <div class="row">
        <div>
          <label for="dir">디렉토리 (기본: / = root)</label>
          <input id="dir" class="mono" value="/">
        </div>
        <div>
          <label for="file">파일명</label>
          <input id="file" class="mono" placeholder="예: index.html">
        </div>
      </div>

      <div class="actions">
        <button id="readBtn">읽기</button>
        <button id="deleteBtn" class="danger">삭제</button>
        <button id="backBtn" class="secondary">이 디렉토리 목록 보기</button>
      </div>
    </section>

    <!-- 복사 -->
    <section class="card">
      <h2>다른 위치로 복사</h2>
      <label for="tBucket">대상 버킷</label>
      <input id="tBucket" class="mono" placeholder="비우면 같은 버킷">
      <div class="row">
        <div>
          <label for="tDir">대상 디렉토리</label>
          <input id="tDir" class="mono" placeholder="비우면 같은 디렉토리">
        </div>
        <div>
          <label for="tFile">대상 파일명</label>
          <input id="tFile" class="mono" placeholder="비우면 같은 파일명">
        </div>
      </div>
      <p class="hint">같은 버킷·같은 디렉토리로 복사할 때는 대상 파일명을 다르게 입력하세요.</p>
      <button id="copyBtn" class="blue">복사</button>
    </section>

    <!-- 결과 -->
    <section class="card">
      <div class="result-head">
        <h2>결과</h2>
        <button id="clipBtn" class="secondary" disabled>내용 클립보드 복사</button>
      </div>
      <div id="msg" class="msg"></div>
      <div id="meta" class="meta"></div>
      <pre id="content" class="placeholder">버킷 이름과 파일명을 입력하고 [읽기]를 누르세요.</pre>
    </section>
  </main>

  <script>
    const LIST_PAGE = "index.html";
    const $ = (id) => document.getElementById(id);
    const DEFAULT_API = "${api_endpoint}"; // Terraform templatefile로 주입

    function normPrefix(p) {
      p = (p || "").trim().replace(/\\/g, "/").replace(/^\/+/, "").replace(/\/{2,}/g, "/");
      if (p && !p.endsWith("/")) p += "/";
      return p;
    }
    function save(k, v) { try { localStorage.setItem("s3fm." + k, v); } catch (e) {} }
    function load(k) { try { return localStorage.getItem("s3fm." + k) || ""; } catch (e) { return ""; } }

    function query(extra) {
      return new URLSearchParams({
        api: $("api").value.trim(),
        bucket: $("bucket").value.trim(),
        prefix: normPrefix($("dir").value),
        ...(extra || {})
      }).toString();
    }

    async function callApi(params) {
      const api = $("api").value.trim();
      if (!api) throw new Error("Lambda 함수 URL을 입력하세요.");
      let url;
      try { url = new URL(api); } catch (e) { throw new Error("Lambda 함수 URL 형식이 올바르지 않습니다."); }
      Object.entries(params).forEach(([k, v]) => url.searchParams.set(k, v));

      const res = await fetch(url, { method: "GET" });
      const text = await res.text();
      let data = null;
      try { data = JSON.parse(text); } catch (e) {}
      if (!res.ok) throw new Error("HTTP " + res.status + " - " + ((data && data.error) || text || res.statusText));
      return data !== null ? data : { content: text };
    }

    function formatSize(n) {
      if (n == null) return "";
      const u = ["B", "KB", "MB", "GB"];
      let i = 0;
      while (n >= 1024 && i < u.length - 1) { n /= 1024; i++; }
      return (i ? n.toFixed(1) : n) + " " + u[i];
    }
    function formatDate(s) {
      const d = new Date(s);
      return isNaN(d) ? (s || "") : d.toLocaleString("ko-KR", { hour12: false });
    }

    function setMsg(text, type) {
      $("msg").textContent = text || "";
      $("msg").className = "msg" + (type ? " " + type : "");
    }
    function setMeta(items) {
      const box = $("meta");
      box.innerHTML = "";
      items.filter(Boolean).forEach((t) => {
        const s = document.createElement("span");
        s.className = "chip";
        s.textContent = t;
        box.appendChild(s);
      });
    }
    function setContent(text, placeholder) {
      $("content").textContent = text;
      $("content").className = placeholder ? "placeholder" : "";
      $("clipBtn").disabled = !!placeholder;
    }
    function busy(on) {
      ["readBtn", "deleteBtn", "copyBtn"].forEach((id) => { $(id).disabled = on; });
    }

    // 공통 입력값 확인
    function target() {
      const bucket = $("bucket").value.trim();
      const prefix = normPrefix($("dir").value);
      const file = $("file").value.trim().replace(/^\/+/, "");
      $("dir").value = "/" + prefix;
      if (!bucket) { setMsg("버킷 이름을 입력하세요.", "error"); return null; }
      if (!file) { setMsg("파일명을 입력하세요.", "error"); return null; }
      save("api", $("api").value.trim());
      save("bucket", bucket);
      history.replaceState(null, "", "?" + query({ file: file }));
      return {
        bucket: bucket, prefix: prefix, file: file,
        path: "s3://" + bucket + "/" + prefix + file,
        params: { bucket_name: bucket, dir_name: prefix || "/", file_name: file }
      };
    }

    // ---------------- 읽기 ----------------
    async function readFile() {
      const t = target();
      if (!t) return;
      setMsg("읽는 중...");
      setMeta([t.path]);
      setContent("불러오는 중...", true);
      busy(true);
      try {
        const data = await callApi({ action: "read", ...t.params });
        setMsg(data.message || "읽기 완료", "ok");
        setMeta([
          t.path,
          data.size != null ? formatSize(data.size) : "",
          data.content_type || "",
          data.last_modified ? formatDate(data.last_modified) : ""
        ]);
        setContent(data.content != null ? data.content : JSON.stringify(data, null, 2));
      } catch (e) {
        setMsg("읽기 실패: " + e.message, "error");
        setContent("-", true);
      } finally {
        busy(false);
      }
    }

    // ---------------- 삭제 ----------------
    async function deleteFile() {
      const t = target();
      if (!t) return;
      if (!confirm("'" + t.path + "' 파일을 삭제합니다. 되돌릴 수 없습니다. 계속할까요?")) return;
      setMsg("삭제 중...");
      setMeta([t.path]);
      busy(true);
      try {
        const data = await callApi({ action: "delete", ...t.params });
        setMsg((data.message || "삭제 완료") + " — " + t.path, "ok");
        setContent("파일이 삭제되었습니다. [이 디렉토리 목록 보기]로 목록을 확인하세요.", true);
      } catch (e) {
        setMsg("삭제 실패: " + e.message, "error");
      } finally {
        busy(false);
      }
    }

    // ---------------- 복사 ----------------
    async function copyFile() {
      const t = target();
      if (!t) return;
      const tBucket = $("tBucket").value.trim() || t.bucket;
      const tDirRaw = $("tDir").value.trim();
      const tPrefix = tDirRaw ? normPrefix(tDirRaw) : t.prefix;
      const tFile = $("tFile").value.trim().replace(/^\/+/, "") || t.file;
      const tPath = "s3://" + tBucket + "/" + tPrefix + tFile;

      if (tPath === t.path) { setMsg("원본과 대상 경로가 같습니다. 대상 파일명이나 디렉토리를 바꾸세요.", "error"); return; }
      if (!confirm(t.path + "\n→ " + tPath + "\n\n복사할까요? (대상에 같은 이름이 있으면 덮어씁니다)")) return;

      setMsg("복사 중...");
      setMeta([t.path, "→ " + tPath]);
      busy(true);
      try {
        const data = await callApi({
          action: "copy", ...t.params,
          target_bucket: tBucket,
          target_dir: tPrefix || "/",
          target_file: tFile
        });
        setMsg((data.message || "복사 완료") + "\n" + (data.source || t.path) + " → " + (data.target || tPath), "ok");
      } catch (e) {
        setMsg("복사 실패: " + e.message, "error");
      } finally {
        busy(false);
      }
    }

    // 초기화: 쿼리스트링(목록 페이지에서 넘어온 값) → 기본 URL → localStorage
    const params = new URLSearchParams(location.search);
    $("api").value = params.get("api") || DEFAULT_API || load("api");
    $("bucket").value = params.get("bucket") || load("bucket");
    $("dir").value = "/" + normPrefix(params.get("prefix") || "");
    $("file").value = params.get("file") || "";

    $("readBtn").addEventListener("click", readFile);
    $("deleteBtn").addEventListener("click", deleteFile);
    $("copyBtn").addEventListener("click", copyFile);
    ["api", "bucket", "dir", "file"].forEach((id) =>
      $(id).addEventListener("keydown", (e) => { if (e.key === "Enter") readFile(); }));

    const goList = (e) => { if (e) e.preventDefault(); location.href = LIST_PAGE + "?" + query(); };
    $("backBtn").addEventListener("click", goList);
    $("navList").addEventListener("click", goList);
    $("navRead").addEventListener("click", (e) => e.preventDefault());

    $("clipBtn").addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText($("content").textContent);
        $("clipBtn").textContent = "복사됨";
      } catch (e) {
        $("clipBtn").textContent = "복사 실패";
      }
      setTimeout(() => { $("clipBtn").textContent = "내용 클립보드 복사"; }, 1500);
    });

    // 목록 페이지에서 파일을 클릭해 들어오면 바로 읽기
    if ($("api").value && $("bucket").value && $("file").value) readFile();
  </script>
</body>
</html>