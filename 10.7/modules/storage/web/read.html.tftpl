<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>S3 파일 읽기</title>
  <style>
    :root { --bg:#f6f7f9; --card:#fff; --text:#1f2937; --muted:#6b7280; --line:#e5e7eb; --accent:#ff9900; --navy:#232f3e; --link:#0b6bcb; --err:#c0392b; }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: -apple-system, "Segoe UI", "Malgun Gothic", sans-serif; background: var(--bg); color: var(--text); }
    header { background: var(--navy); color: #fff; padding: 14px 16px; }
    header .inner, main { max-width: 860px; margin: 0 auto; }
    header .inner { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
    header h1 { margin: 0; font-size: 18px; }
    nav a { color: #cbd5e1; text-decoration: none; margin-left: 14px; font-size: 14px; }
    nav a.active { color: var(--accent); font-weight: 700; }
    main { padding: 20px 16px; }
    .card { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 16px; margin-bottom: 16px; }
    label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 4px; }
    input { width: 100%; padding: 9px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 14px; margin-bottom: 12px; }
    input:focus { outline: 2px solid var(--accent); border-color: var(--accent); }
    .mono { font-family: Consolas, "D2Coding", monospace; }
    .row { display: flex; gap: 12px; }
    .row > div { flex: 1; }
    .actions { display: flex; gap: 8px; flex-wrap: wrap; }
    button { padding: 10px 18px; border: 0; border-radius: 6px; background: var(--accent); color: var(--navy); font-weight: 700; font-size: 14px; cursor: pointer; }
    button.secondary { background: #e2e8f0; color: var(--text); }
    button:disabled { background: #cbd5e1; cursor: default; }
    .result-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 10px; }
    .result-head h2 { margin: 0; font-size: 16px; }
    .meta { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }
    .chip { background: #f1f5f9; border: 1px solid var(--line); border-radius: 999px; padding: 3px 10px; font-size: 12px; font-family: Consolas, monospace; word-break: break-all; }
    pre { margin: 0; background: #0f172a; color: #e2e8f0; padding: 14px; border-radius: 6px; font-family: Consolas, "D2Coding", monospace; font-size: 13px; line-height: 1.5; white-space: pre-wrap; word-break: break-all; max-height: 60vh; overflow: auto; }
    pre.error { background: #fdecea; color: var(--err); }
    pre.placeholder { background: #f1f5f9; color: var(--muted); }
    @media (max-width: 600px) { .row { flex-direction: column; gap: 0; } }
  </style>
</head>
<body>
  <header>
    <div class="inner">
      <h1>S3 파일 관리</h1>
      <nav>
        <a href="#" id="navList">파일 목록</a>
        <a href="#" id="navRead" class="active">파일 읽기</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="card">
      <label for="api">Lambda 함수 URL</label>
      <input id="api" class="mono" placeholder="https://xxxxxxxx.lambda-url.ap-northeast-3.on.aws/">

      <label for="bucket">버킷 이름</label>
      <input id="bucket" class="mono" placeholder="예: std17-test-bucket">

      <div class="row">
        <div>
          <label for="dir">디렉토리 (기본: / = root)</label>
          <input id="dir" class="mono" value="/">
        </div>
        <div>
          <label for="file">파일명</label>
          <input id="file" class="mono" placeholder="예: index.html">
        </div>
      </div>

      <div class="actions">
        <button id="readBtn">읽기</button>
        <button id="backBtn" class="secondary">이 디렉토리 목록 보기</button>
      </div>
    </section>

    <section class="card">
      <div class="result-head">
        <h2>파일 내용</h2>
        <button id="copyBtn" class="secondary" disabled>내용 복사</button>
      </div>
      <div id="meta" class="meta"></div>
      <pre id="content" class="placeholder">버킷 이름과 파일명을 입력하고 [읽기]를 누르세요.</pre>
    </section>
  </main>

  <script>
    const LIST_PAGE = "index.html";
    const $ = (id) => document.getElementById(id);
    const DEFAULT_API = "${api_endpoint}"; // Terraform templatefile로 주입

    function normPrefix(p) {
      p = (p || "").trim().replace(/\\/g, "/").replace(/^\/+/, "").replace(/\/{2,}/g, "/");
      if (p && !p.endsWith("/")) p += "/";
      return p;
    }
    function save(k, v) { try { localStorage.setItem("s3fm." + k, v); } catch (e) {} }
    function load(k) { try { return localStorage.getItem("s3fm." + k) || ""; } catch (e) { return ""; } }

    function query(extra) {
      return new URLSearchParams({
        api: $("api").value.trim(),
        bucket: $("bucket").value.trim(),
        prefix: normPrefix($("dir").value),
        ...(extra || {})
      }).toString();
    }

    async function callApi(params) {
      const api = $("api").value.trim();
      if (!api) throw new Error("Lambda 함수 URL을 입력하세요.");
      let url;
      try { url = new URL(api); } catch (e) { throw new Error("Lambda 함수 URL 형식이 올바르지 않습니다."); }
      Object.entries(params).forEach(([k, v]) => url.searchParams.set(k, v));

      const res = await fetch(url, { method: "GET" });
      const text = await res.text();
      let data = null;
      try { data = JSON.parse(text); } catch (e) {}
      if (!res.ok) throw new Error("HTTP " + res.status + " - " + ((data && data.error) || text || res.statusText));
      return data !== null ? data : text;
    }

    function formatSize(n) {
      if (n == null) return "";
      const u = ["B", "KB", "MB", "GB"];
      let i = 0;
      while (n >= 1024 && i < u.length - 1) { n /= 1024; i++; }
      return (i ? n.toFixed(1) : n) + " " + u[i];
    }
    function formatDate(s) {
      const d = new Date(s);
      return isNaN(d) ? (s || "") : d.toLocaleString("ko-KR", { hour12: false });
    }

    function setMeta(items) {
      const box = $("meta");
      box.innerHTML = "";
      items.filter(Boolean).forEach((t) => {
        const s = document.createElement("span");
        s.className = "chip";
        s.textContent = t;
        box.appendChild(s);
      });
    }
    function showContent(text, cls) {
      const pre = $("content");
      pre.textContent = text;
      pre.className = cls || "";
      $("copyBtn").disabled = cls !== undefined && cls !== "";
    }

    async function readFile() {
      const bucket = $("bucket").value.trim();
      const prefix = normPrefix($("dir").value);
      const file = $("file").value.trim().replace(/^\/+/, "");
      $("dir").value = "/" + prefix;

      if (!bucket) { setMeta([]); showContent("버킷 이름을 입력하세요.", "error"); return; }
      if (!file) { setMeta([]); showContent("파일명을 입력하세요.", "error"); return; }

      const key = prefix + file;
      save("api", $("api").value.trim());
      save("bucket", bucket);
      history.replaceState(null, "", "?" + query({ file }));

      setMeta(["s3://" + bucket + "/" + key]);
      showContent("불러오는 중...", "placeholder");
      $("readBtn").disabled = true;

      try {
        const data = await callApi({ action: "read", bucket, key });
        if (typeof data === "string") {
          showContent(data);
        } else {
          setMeta([
            "s3://" + bucket + "/" + key,
            data.size != null ? formatSize(data.size) : "",
            data.content_type || "",
            data.last_modified ? formatDate(data.last_modified) : ""
          ]);
          showContent(data.content != null ? data.content : JSON.stringify(data, null, 2));
        }
      } catch (e) {
        showContent("파일 읽기 실패: " + e.message, "error");
      } finally {
        $("readBtn").disabled = false;
      }
    }

    // 초기화: 쿼리스트링(목록 페이지에서 넘어온 값) → localStorage 순
    const params = new URLSearchParams(location.search);
    $("api").value = params.get("api") || DEFAULT_API || load("api");
    $("bucket").value = params.get("bucket") || load("bucket");
    $("dir").value = "/" + normPrefix(params.get("prefix") || "");
    $("file").value = params.get("file") || "";

    $("readBtn").addEventListener("click", readFile);
    ["api", "bucket", "dir", "file"].forEach((id) =>
      $(id).addEventListener("keydown", (e) => { if (e.key === "Enter") readFile(); }));

    const goList = (e) => { if (e) e.preventDefault(); location.href = LIST_PAGE + "?" + query(); };
    $("backBtn").addEventListener("click", goList);
    $("navList").addEventListener("click", goList);
    $("navRead").addEventListener("click", (e) => e.preventDefault());

    $("copyBtn").addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText($("content").textContent);
        $("copyBtn").textContent = "복사됨";
      } catch (e) {
        $("copyBtn").textContent = "복사 실패";
      }
      setTimeout(() => { $("copyBtn").textContent = "내용 복사"; }, 1500);
    });

    // 목록 페이지에서 파일을 클릭해 들어오면 바로 읽기
    if ($("api").value && $("bucket").value && $("file").value) readFile();
  </script>
</body>
</html>