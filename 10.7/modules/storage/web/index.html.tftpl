<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>S3 파일 목록</title>
  <style>
    :root { --bg:#f6f7f9; --card:#fff; --text:#1f2937; --muted:#6b7280; --line:#e5e7eb; --accent:#ff9900; --navy:#232f3e; --link:#0b6bcb; --err:#c0392b; }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: -apple-system, "Segoe UI", "Malgun Gothic", sans-serif; background: var(--bg); color: var(--text); }
    header { background: var(--navy); color: #fff; padding: 14px 16px; }
    header .inner, main { max-width: 860px; margin: 0 auto; }
    header .inner { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
    header h1 { margin: 0; font-size: 18px; }
    nav a { color: #cbd5e1; text-decoration: none; margin-left: 14px; font-size: 14px; }
    nav a.active { color: var(--accent); font-weight: 700; }
    main { padding: 20px 16px; }
    .card { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 16px; margin-bottom: 16px; }
    label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 4px; }
    input { width: 100%; padding: 9px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 14px; margin-bottom: 12px; }
    input:focus { outline: 2px solid var(--accent); border-color: var(--accent); }
    .mono { font-family: Consolas, "D2Coding", monospace; }
    .row { display: flex; gap: 12px; }
    .row > div { flex: 1; }
    button { padding: 10px 18px; border: 0; border-radius: 6px; background: var(--accent); color: var(--navy); font-weight: 700; font-size: 14px; cursor: pointer; }
    button:disabled { background: #cbd5e1; cursor: default; }
    .list-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 10px; }
    .crumbs { font-family: Consolas, monospace; font-size: 14px; word-break: break-all; }
    .crumbs a { color: var(--link); text-decoration: none; }
    .crumbs a:hover { text-decoration: underline; }
    .muted { color: var(--muted); font-size: 13px; }
    .status { padding: 10px 0; color: var(--muted); font-size: 14px; }
    .status.error { color: var(--err); white-space: pre-wrap; }
    .list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
    .list li { border-bottom: 1px solid var(--line); }
    .item { display: flex; align-items: center; gap: 10px; padding: 10px 6px; color: var(--text); text-decoration: none; }
    .item:hover { background: #fff7eb; }
    .item .icon { width: 22px; text-align: center; }
    .item .name { flex: 1; font-family: Consolas, monospace; font-size: 14px; word-break: break-all; }
    .item .meta { color: var(--muted); font-size: 12px; text-align: right; white-space: nowrap; }
    @media (max-width: 600px) {
      .row { flex-direction: column; gap: 0; }
      .item .meta { white-space: normal; }
    }
  </style>
</head>
<body>
  <header>
    <div class="inner">
      <h1>S3 파일 관리</h1>
      <nav>
        <a href="#" id="navList" class="active">파일 목록</a>
        <a href="#" id="navRead">파일 읽기</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="card">
      <label for="api">Lambda 함수 URL</label>
      <input id="api" class="mono" placeholder="https://xxxxxxxx.lambda-url.eu-west-2.on.aws/">

      <div class="row">
        <div>
          <label for="bucket">버킷 이름</label>
          <input id="bucket" class="mono" placeholder="예: std17-test-bucket">
        </div>
        <div>
          <label for="dir">디렉토리 (기본: / = root)</label>
          <input id="dir" class="mono" value="/">
        </div>
      </div>

      <button id="listBtn">목록 조회</button>
    </section>

    <section class="card">
      <div class="list-head">
        <div id="crumbs" class="crumbs"></div>
        <span id="count" class="muted"></span>
      </div>
      <div id="status" class="status">버킷 이름을 입력하고 [목록 조회]를 누르세요.</div>
      <ul id="list" class="list"></ul>
    </section>
  </main>

  <script>
    const READ_PAGE = "read.html";
    const $ = (id) => document.getElementById(id);
    const DEFAULT_API = "${api_endpoint}"; // Terraform templatefile로 주입

    // "/a/b" , "a/b/" , "/" → "a/b/" , "" (root)
    function normPrefix(p) {
      p = (p || "").trim().replace(/\\/g, "/").replace(/^\/+/, "").replace(/\/{2,}/g, "/");
      if (p && !p.endsWith("/")) p += "/";
      return p;
    }
    function save(k, v) { try { localStorage.setItem("s3fm." + k, v); } catch (e) {} }
    function load(k) { try { return localStorage.getItem("s3fm." + k) || ""; } catch (e) { return ""; } }

    // 현재 입력값을 쿼리스트링으로 넘겨 다른 페이지와 연결
    function query(extra) {
      return new URLSearchParams({
        api: $("api").value.trim(),
        bucket: $("bucket").value.trim(),
        prefix: normPrefix($("dir").value),
        ...(extra || {})
      }).toString();
    }

    async function callApi(params) {
      const api = $("api").value.trim();
      if (!api) throw new Error("Lambda 함수 URL을 입력하세요.");
      let url;
      try { url = new URL(api); } catch (e) { throw new Error("Lambda 함수 URL 형식이 올바르지 않습니다."); }
      Object.entries(params).forEach(([k, v]) => url.searchParams.set(k, v));

      const res = await fetch(url, { method: "GET" });
      const text = await res.text();
      let data = null;
      try { data = JSON.parse(text); } catch (e) {}
      if (!res.ok) throw new Error("HTTP " + res.status + " - " + ((data && data.error) || text || res.statusText));
      return data !== null ? data : text;
    }

    function formatSize(n) {
      if (n == null) return "";
      const u = ["B", "KB", "MB", "GB", "TB"];
      let i = 0;
      while (n >= 1024 && i < u.length - 1) { n /= 1024; i++; }
      return (i ? n.toFixed(1) : n) + " " + u[i];
    }
    function formatDate(s) {
      const d = new Date(s);
      return isNaN(d) ? (s || "") : d.toLocaleString("ko-KR", { hour12: false });
    }
    function setStatus(msg, isErr) {
      const el = $("status");
      el.textContent = msg;
      el.className = "status" + (isErr ? " error" : "");
      el.hidden = !msg;
    }

    function renderCrumbs(prefix) {
      const box = $("crumbs");
      box.innerHTML = "";
      const add = (label, p) => {
        const a = document.createElement("a");
        a.href = "#";
        a.textContent = label;
        a.onclick = (e) => { e.preventDefault(); goTo(p); };
        box.appendChild(a);
      };
      add("root", "");
      let acc = "";
      prefix.split("/").filter(Boolean).forEach((part) => {
        acc += part + "/";
        box.appendChild(document.createTextNode(" / "));
        add(part, acc);
      });
    }

    function goTo(prefix) {
      $("dir").value = "/" + prefix;
      loadList();
    }

    function addItem(icon, name, meta, href, onClick) {
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.className = "item";
      a.href = href || "#";
      if (onClick) a.onclick = (e) => { e.preventDefault(); onClick(); };
      [["icon", icon], ["name", name], ["meta", meta]].forEach(([cls, txt]) => {
        const s = document.createElement("span");
        s.className = cls;
        s.textContent = txt;
        a.appendChild(s);
      });
      li.appendChild(a);
      $("list").appendChild(li);
    }

    async function loadList() {
      const bucket = $("bucket").value.trim();
      const prefix = normPrefix($("dir").value);
      $("dir").value = "/" + prefix;
      renderCrumbs(prefix);
      $("list").innerHTML = "";
      $("count").textContent = "";

      if (!bucket) { setStatus("버킷 이름을 입력하세요.", true); return; }

      save("api", $("api").value.trim());
      save("bucket", bucket);
      history.replaceState(null, "", "?" + query());

      setStatus("불러오는 중...");
      $("listBtn").disabled = true;

      try {
        const data = await callApi({ action: "list", bucket_name: bucket, dir_name: prefix || "/" });
        const folders = data.folders || [];
        const files = data.files || [];

        if (prefix) {
          const trimmed = prefix.slice(0, -1);
          const idx = trimmed.lastIndexOf("/");
          const parent = idx < 0 ? "" : trimmed.slice(0, idx + 1);
          addItem("⬆️", "..", "상위 폴더", null, () => goTo(parent));
        }
        folders.forEach((f) => {
          addItem("📁", f.slice(prefix.length), "폴더", null, () => goTo(f));
        });
        files.forEach((f) => {
          const name = f.key.slice(prefix.length);
          addItem("📄", name, formatSize(f.size) + " · " + formatDate(f.last_modified),
                  READ_PAGE + "?" + query({ file: name }));
        });

        $("count").textContent = "폴더 " + folders.length + " · 파일 " + files.length;
        setStatus(folders.length + files.length === 0 ? "이 디렉토리에 파일이 없습니다." : "");
      } catch (e) {
        setStatus("목록 조회 실패: " + e.message, true);
      } finally {
        $("listBtn").disabled = false;
      }
    }

    // 초기화: 쿼리스트링 → localStorage 순으로 값 채우기
    const params = new URLSearchParams(location.search);
    $("api").value = params.get("api") || DEFAULT_API || load("api");
    $("bucket").value = params.get("bucket") || load("bucket");
    $("dir").value = "/" + normPrefix(params.get("prefix") || "");
    renderCrumbs(normPrefix($("dir").value));

    $("listBtn").addEventListener("click", loadList);
    ["api", "bucket", "dir"].forEach((id) =>
      $(id).addEventListener("keydown", (e) => { if (e.key === "Enter") loadList(); }));
    $("navList").addEventListener("click", (e) => e.preventDefault());
    $("navRead").addEventListener("click", (e) => { e.preventDefault(); location.href = READ_PAGE + "?" + query(); });

    if ($("api").value && $("bucket").value) loadList();
  </script>
</body>
</html>