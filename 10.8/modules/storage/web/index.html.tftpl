<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>std17 썸네일 생성기</title>
  <style>
    :root {
      --bg: #f5f6f8; --card: #ffffff; --text: #1f2328; --muted: #6b7280;
      --line: #e5e7eb; --accent: #2563eb; --ok: #16a34a; --err: #dc2626;
    }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: system-ui, -apple-system, "Malgun Gothic", sans-serif;
           background: var(--bg); color: var(--text); }
    .wrap { max-width: 960px; margin: 0 auto; padding: 24px 16px 48px; }
    h1 { font-size: 22px; margin: 0 0 4px; }
    .sub { color: var(--muted); font-size: 14px; margin: 0 0 20px; }
    .card { background: var(--card); border: 1px solid var(--line); border-radius: 12px;
            padding: 20px; margin-bottom: 20px; }
    .drop { border: 2px dashed var(--line); border-radius: 10px; padding: 32px 16px;
            text-align: center; color: var(--muted); cursor: pointer; transition: .15s; }
    .drop.over { border-color: var(--accent); background: #eff6ff; color: var(--accent); }
    .drop strong { color: var(--text); }
    #fileInput { display: none; }
    .status { list-style: none; padding: 0; margin: 16px 0 0; font-size: 14px; }
    .status li { display: flex; justify-content: space-between; gap: 12px;
                 padding: 8px 0; border-top: 1px solid var(--line); }
    .status .name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ok { color: var(--ok); } .err { color: var(--err); } .wait { color: var(--muted); }
    .head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
    .head h2 { font-size: 17px; margin: 0; }
    button { border: 1px solid var(--line); background: #fff; border-radius: 8px;
             padding: 6px 12px; cursor: pointer; font-size: 14px; }
    button:hover { border-color: var(--accent); color: var(--accent); }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
    .item { border: 1px solid var(--line); border-radius: 10px; overflow: hidden; background: #fafafa; }
    .item a { display: block; }
    .item img { width: 100%; height: 150px; object-fit: contain; background: #fff; display: block; }
    .item .cap { padding: 8px; font-size: 12px; color: var(--muted);
                 overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .empty { color: var(--muted); font-size: 14px; text-align: center; padding: 24px 0; }
  </style>
</head>
<body>
  <div class="wrap">
    <h1>std17 썸네일 생성기</h1>
    <p class="sub">uploads/ 에 이미지를 올리면 Lambda가 200×200 썸네일을 thumbnails/ 에 만듭니다.</p>

    <div class="card">
      <label class="drop" id="drop">
        <strong>이미지를 끌어다 놓거나 클릭해서 선택</strong><br>
        jpg · jpeg · png · webp · gif
        <input type="file" id="fileInput" accept=".jpg,.jpeg,.png,.webp,.gif" multiple>
      </label>
      <ul class="status" id="status"></ul>
    </div>

    <div class="card">
      <div class="head">
        <h2>썸네일 목록</h2>
        <button id="refresh">새로고침</button>
      </div>
      <div class="grid" id="grid"></div>
    </div>
  </div>

  <script>
    // S3 REST 엔드포인트 (Terraform templatefile 로 주입)
    const S3 = "https://${s3_endpoint}";
    const ALLOWED = [".jpg", ".jpeg", ".png", ".webp", ".gif"];

    const grid = document.getElementById("grid");
    const statusList = document.getElementById("status");
    const drop = document.getElementById("drop");
    const fileInput = document.getElementById("fileInput");

    const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
    const encodeKey = (key) => key.split("/").map(encodeURIComponent).join("/");
    const extOf = (name) => {
      const i = name.lastIndexOf(".");
      return i < 0 ? "" : name.slice(i).toLowerCase();
    };

    // ---------------- 목록 ----------------
    async function listKeys(prefix) {
      const res = await fetch(S3 + "/?list-type=2&prefix=" + encodeURIComponent(prefix), { cache: "no-store" });
      if (!res.ok) throw new Error("목록 조회 실패 (" + res.status + ")");
      const xml = new DOMParser().parseFromString(await res.text(), "application/xml");
      return Array.from(xml.getElementsByTagName("Contents"))
        .map((c) => ({
          key: c.getElementsByTagName("Key")[0].textContent,
          modified: c.getElementsByTagName("LastModified")[0].textContent,
        }))
        .filter((o) => !o.key.endsWith("/"));
    }

    async function loadGallery() {
      grid.replaceChildren();
      try {
        const items = await listKeys("thumbnails/");
        items.sort((a, b) => b.modified.localeCompare(a.modified));
        if (items.length === 0) {
          const p = document.createElement("div");
          p.className = "empty";
          p.textContent = "아직 썸네일이 없습니다.";
          grid.appendChild(p);
          return;
        }
        for (const it of items) {
          const name = it.key.slice("thumbnails/".length);
          const card = document.createElement("div");
          card.className = "item";

          const a = document.createElement("a");
          a.href = S3 + "/uploads/" + encodeKey(name);   // 클릭 시 원본
          a.target = "_blank";
          a.title = "원본 보기";

          const img = document.createElement("img");
          img.src = S3 + "/" + encodeKey(it.key) + "?t=" + Date.parse(it.modified);
          img.alt = name;
          img.loading = "lazy";

          const cap = document.createElement("div");
          cap.className = "cap";
          cap.textContent = name;

          a.appendChild(img);
          card.append(a, cap);
          grid.appendChild(card);
        }
      } catch (e) {
        const p = document.createElement("div");
        p.className = "empty err";
        p.textContent = e.message;
        grid.appendChild(p);
      }
    }

    // ---------------- 업로드 ----------------
    function addStatus(name) {
      const li = document.createElement("li");
      const n = document.createElement("span");
      n.className = "name";
      n.textContent = name;
      const s = document.createElement("span");
      li.append(n, s);
      statusList.prepend(li);
      return (text, cls) => { s.textContent = text; s.className = cls; };
    }

    async function waitThumbnail(name) {
      const url = S3 + "/thumbnails/" + encodeKey(name);
      for (let i = 0; i < 20; i++) {          // 최대 약 30초 대기
        await sleep(1500);
        const res = await fetch(url, { method: "HEAD", cache: "no-store" });
        if (res.ok) return true;
      }
      return false;
    }

    async function upload(file) {
      const set = addStatus(file.name);
      if (!ALLOWED.includes(extOf(file.name))) {
        set("지원하지 않는 형식", "err");
        return;
      }
      try {
        set("업로드 중…", "wait");
        const res = await fetch(S3 + "/uploads/" + encodeKey(file.name), {
          method: "PUT",
          headers: { "Content-Type": file.type || "application/octet-stream" },
          body: file,
        });
        if (!res.ok) throw new Error("업로드 실패 (" + res.status + ")");

        set("썸네일 생성 대기…", "wait");
        if (await waitThumbnail(file.name)) {
          set("완료", "ok");
          loadGallery();
        } else {
          set("시간 초과 (Lambda 로그 확인)", "err");
        }
      } catch (e) {
        set(e.message, "err");
      }
    }

    function handleFiles(files) {
      for (const f of files) upload(f);
    }

    fileInput.addEventListener("change", () => { handleFiles(fileInput.files); fileInput.value = ""; });
    ["dragenter", "dragover"].forEach((ev) =>
      drop.addEventListener(ev, (e) => { e.preventDefault(); drop.classList.add("over"); }));
    ["dragleave", "drop"].forEach((ev) =>
      drop.addEventListener(ev, (e) => { e.preventDefault(); drop.classList.remove("over"); }));
    drop.addEventListener("drop", (e) => handleFiles(e.dataTransfer.files));
    document.getElementById("refresh").addEventListener("click", loadGallery);

    loadGallery();
  </script>
</body>
</html>